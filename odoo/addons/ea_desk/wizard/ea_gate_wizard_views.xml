<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ea_gate_wizard_form" model="ir.ui.view">
        <field name="name">ea.gate.wizard.form</field>
        <field name="model">ea.gate.wizard</field>
        <field name="arch" type="xml">
            <form>
                <div class="text-muted mb-2">Pencatatan persetujuan sesuai RACI. Penyetuju gerbang <field name="stage_id" readonly="1" class="d-inline"/>: <b><field name="stage_approver" readonly="1" class="d-inline"/></b>.</div>
                <group>
                    <field name="engagement_id" invisible="1"/>
                    <field name="is_last" invisible="1"/>
                    <field name="product_id" invisible="1"/>
                    <field name="approved_by"/>
                    <field name="note"/>
                </group>
                <div class="alert alert-warning" role="alert" invisible="not draft_artifacts">
                    Artefak masih Draft: <field name="draft_artifacts" class="d-inline"/>. Sahkan atau tandai Usang dulu sebelum harvest.
                </div>
                <div invisible="not is_last">
                    <div class="alert alert-info" role="alert" invisible="not product_id">
                        Lessons learned masuk ke backlog /foundation dan menjadi bahan perbaikan resep <field name="product_id" readonly="1" class="d-inline"/>.
                    </div>
                    <field name="lesson_ids">
                        <list editable="bottom"><field name="name" placeholder="mis. Perlu template ADR untuk integrasi vendor"/><field name="kind"/></list>
                    </field>
                </div>
                <footer>
                    <button name="action_confirm" type="object" string="Setujui gerbang" class="btn-primary" invisible="is_last"/>
                    <button name="action_confirm" type="object" string="Harvest &amp; tutup engagement" class="btn-primary" invisible="not is_last"/>
                    <button string="Batal" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
