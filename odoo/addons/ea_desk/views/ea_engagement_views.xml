<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ea_engagement_kanban" model="ir.ui.view">
        <field name="name">ea.engagement.kanban</field>
        <field name="model">ea.engagement</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" highlight_color="mode_color" quick_create="0" group_create="0" group_delete="0" group_edit="0" records_draggable="0">
                <field name="state"/>
                <field name="gate_ready"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between small">
                            <field name="code" class="text-muted font-monospace"/>
                            <field name="mode_id" widget="badge"/>
                        </div>
                        <field name="name" class="fw-bold mt-1"/>
                        <field name="product_id" class="small text-muted"/>
                        <div class="d-flex justify-content-between small mt-1">
                            <field name="sponsor_id"/>
                            <span t-if="record.state.raw_value == 'on_hold'" class="badge text-bg-warning">Ditunda</span>
                            <span t-elif="record.gate_ready.raw_value" class="badge ea-accent-badge">Siap gerbang</span>
                        </div>
                        <field name="gate_progress" widget="progressbar"/>
                        <footer class="small">
                            <field name="activity_ids" widget="kanban_activity"/>
                            <field name="target_date" class="ms-auto text-muted"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_ea_engagement_list" model="ir.ui.view">
        <field name="name">ea.engagement.list</field>
        <field name="model">ea.engagement</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('closed', 'cancelled')" decoration-warning="state == 'on_hold'">
                <field name="code"/>
                <field name="name"/>
                <field name="product_id"/>
                <field name="mode_id"/>
                <field name="stage_id"/>
                <field name="sponsor_id"/>
                <field name="gate_progress" widget="progressbar"/>
                <field name="target_date"/>
                <field name="state" widget="badge" decoration-info="state == 'active'" decoration-warning="state == 'on_hold'" decoration-success="state == 'closed'" decoration-danger="state == 'cancelled'"/>
                <field name="write_date" string="Diperbarui" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_ea_engagement_form" model="ir.ui.view">
        <field name="name">ea.engagement.form</field>
        <field name="model">ea.engagement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_gate" type="object" string="Lewati gerbang →" class="btn-primary" invisible="state != 'active' or not gate_ready"/>
                    <button name="action_generate_document" type="object" string="Buat dokumen" icon="fa-file-text-o" invisible="not id or not product_id"/>
                    <button name="action_hold" type="object" string="Tunda" invisible="state != 'active' or not id"/>
                    <button name="action_resume" type="object" string="Lanjutkan" invisible="state != 'on_hold'"/>
                    <button name="action_cancel" type="object" string="Batalkan" invisible="state not in ('active', 'on_hold') or not id" confirm="Batalkan engagement ini? Riwayat tetap tersimpan."/>
                    <field name="stage_id" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_decisions" type="object" class="oe_stat_button" icon="fa-gavel" invisible="not id">
                            <field name="decision_count" widget="statinfo" string="ADR"/>
                        </button>
                        <button name="action_view_artifacts" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="not id">
                            <field name="artifact_count" widget="statinfo" string="Artefak"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Selesai" invisible="state != 'closed'"/>
                    <widget name="web_ribbon" title="Ditunda" bg_color="text-bg-warning" invisible="state != 'on_hold'"/>
                    <widget name="web_ribbon" title="Dibatalkan" bg_color="text-bg-danger" invisible="state != 'cancelled'"/>
                    <field name="state" invisible="1"/>
                    <field name="gate_ready" invisible="1"/>
                    <field name="flow_stage_ids" invisible="1"/>
                    <div class="oe_title">
                        <div class="text-muted font-monospace"><field name="code" readonly="1"/></div>
                        <h1><field name="name" placeholder="mis. Konsolidasi aplikasi procurement"/></h1>
                    </div>
                    <group>
                        <group string="Pelanggan &amp; keputusan">
                            <field name="product_id" options="{'no_create': True}" placeholder="Kosong = resep umum Planting Seed"/>
                            <field name="sponsor_id"/>
                            <field name="domain_owner_id"/>
                            <field name="delivery_team"/>
                            <field name="requester"/>
                        </group>
                        <group string="Mode &amp; risiko">
                            <field name="mode_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="strategy_level"/>
                            <field name="risk"/>
                            <field name="target_date"/>
                            <field name="classification_id" string="Klasifikasi informasi"/>
                            <field name="classification_override_id" options="{'no_create': True}" placeholder="Bawaan produk"/>
                        </group>
                    </group>
                    <group><field name="decision_needed" placeholder="mis. Memilih satu platform procurement sebagai System of Record"/></group>
                    <notebook>
                        <page string="Tahap aktif" name="current">
                            <div class="alert alert-info" role="status" invisible="id">
                                Simpan engagement ini untuk memulai tahap pertama. Resep kerja dan kriteria gerbang muncul sesuai produk dan mode yang dipilih.
                            </div>
                            <div class="alert alert-light border" role="status" invisible="state in ('closed', 'cancelled')">
                                <b><field name="stage_id" readonly="1" nolabel="1" class="d-inline"/></b> · <field name="stage_purpose" class="d-inline"/>
                                <div class="small mt-1">Penyetuju gerbang: <b><field name="stage_approver" readonly="1" class="d-inline"/></b> · kriteria <field name="gate_done" class="d-inline"/>/<field name="gate_total" class="d-inline"/></div>
                            </div>
                            <div class="alert alert-warning" role="alert" invisible="not missed_artifacts">
                                <b>Tertinggal dari tahap sebelumnya:</b>
                                <field name="missed_artifacts" class="d-block"/>
                                <span class="small">Daftarkan lewat tab Riwayat → Semua langkah.</span>
                            </div>
                            <separator string="Resep kerja · cara mengerjakan tahap ini"/>
                            <field name="step_line_ids" nolabel="1" readonly="state != 'active'">
                                <list editable="bottom" create="0" delete="0" decoration-bf="is_next" decoration-muted="done">
                                    <field name="is_next" column_invisible="1"/>
                                    <field name="template_id" column_invisible="1"/>
                                    <field name="makes_adr" column_invisible="1"/>
                                    <field name="artifact_name" column_invisible="1"/>
                                    <field name="done" widget="boolean_toggle" nolabel="1"/>
                                    <field name="name" readonly="1" string="Langkah" width="260px"/>
                                    <field name="hint" widget="badge" class="o_ea_hint" nolabel="1" width="110px"/>
                                    <field name="altitude" readonly="1" width="120px"/>
                                    <field name="how" readonly="1"/>
                                    <field name="output" readonly="1" width="190px"/>
                                    <button name="action_view_template" type="object" string="Template" icon="fa-file-text-o" invisible="not template_id"/>
                                    <button name="action_register_artifact" type="object" string="Daftarkan artefak" icon="fa-plus" invisible="not artifact_name or artifact_id"/>
                                    <field name="artifact_id" readonly="1" invisible="not artifact_id" string="Artefak"/>
                                    <button name="action_new_adr" type="object" string="Buat ADR" icon="fa-gavel" invisible="not makes_adr"/>
                                </list>
                            </field>
                            <separator string="Kriteria gerbang · bukti selesai yang ditinjau penyetuju"/>
                            <field name="criterion_line_ids" nolabel="1" readonly="state != 'active'">
                                <list editable="bottom" create="0" delete="0" decoration-muted="done">
                                    <field name="done" widget="boolean_toggle" nolabel="1"/>
                                    <field name="name" readonly="1" string="Kriteria"/>
                                    <field name="optional" readonly="1"/>
                                </list>
                            </field>
                            <div class="text-muted small mt-2"><b>Peran EA di mode ini:</b> <field name="mode_role" class="d-inline"/></div>
                        </page>
                        <page string="Template dokumen" name="templates" invisible="not id">
                            <div class="text-muted small mb-2">Template produk dan template umum. Tersedia di semua tahap, termasuk setelah engagement selesai.</div>
                            <field name="template_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="product_id" string="Sumber" placeholder="Umum"/>
                                    <button name="action_open_preview" type="object" string="Buka" icon="fa-eye"/>
                                </list>
                            </field>
                        </page>
                        <page string="Kanvas Scope" name="scope">
                            <group>
                                <group string="Masalah bisnis"><field name="problem" nolabel="1" colspan="2"/></group>
                                <group string="Vertical slice B-D-A-T">
                                    <field name="slice_business"/>
                                    <field name="slice_data"/>
                                    <field name="slice_application"/>
                                    <field name="slice_technology"/>
                                </group>
                                <group string="Di luar lingkup"><field name="out_of_scope" nolabel="1" colspan="2"/></group>
                            </group>
                        </page>
                        <page string="Keputusan (ADR)" name="decisions" invisible="not id">
                            <field name="decision_ids" context="{'default_engagement_id': id}">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="state" widget="badge" decoration-warning="state == 'proposed'" decoration-success="state == 'accepted'" decoration-danger="state == 'rejected'"/>
                                    <field name="decided_by"/>
                                </list>
                            </field>
                        </page>
                        <page string="Isu &amp; Asumsi" name="issues" invisible="not id">
                            <field name="issue_ids" context="{'default_engagement_id': id}">
                                <list decoration-muted="state != 'open'">
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="kind"/>
                                    <field name="owner"/>
                                    <field name="due_date"/>
                                    <field name="state" widget="badge" decoration-warning="state == 'open'" decoration-success="state == 'resolved'" decoration-info="state == 'to_adr'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Artefak" name="artifacts" invisible="not id">
                            <field name="artifact_ids" context="{'default_engagement_id': id, 'default_consumer': sponsor_id}">
                                <list>
                                    <field name="name"/>
                                    <field name="document_code" optional="show"/>
                                    <field name="type"/>
                                    <field name="owner"/>
                                    <field name="location" widget="url"/>
                                    <field name="attachment_count" string="Unggahan"/>
                                    <field name="state" widget="badge" decoration-warning="state == 'draft'" decoration-success="state == 'harvested'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Riwayat" name="history" invisible="not id">
                            <separator string="Gerbang yang dilewati"/>
                            <field name="gate_ids" readonly="1">
                                <list><field name="stage_id"/><field name="approved_by"/><field name="passed_date"/><field name="note"/></list>
                            </field>
                            <separator string="Semua langkah &amp; kriteria"/>
                            <field name="line_ids" readonly="1">
                                <list decoration-muted="not is_current">
                                    <field name="is_current" column_invisible="1"/>
                                    <field name="artifact_name" column_invisible="1"/>
                                    <field name="stage_id"/>
                                    <field name="kind"/>
                                    <field name="name"/>
                                    <field name="done"/>
                                    <field name="done_date"/>
                                    <field name="artifact_id" string="Artefak"/>
                                    <button name="action_register_artifact" type="object" string="Daftarkan artefak" icon="fa-plus" invisible="not artifact_name or artifact_id"/>
                                </list>
                            </field>
                            <separator string="Masukan ke /foundation"/>
                            <field name="foundation_ids" readonly="1">
                                <list><field name="name"/><field name="kind"/><field name="state"/></list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ea_engagement_search" model="ir.ui.view">
        <field name="name">ea.engagement.search</field>
        <field name="model">ea.engagement</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="sponsor_id"/>
                <field name="product_id"/>
                <filter name="running" string="Berjalan" domain="[('state', 'in', ('active', 'on_hold'))]"/>
                <filter name="closed" string="Selesai" domain="[('state', '=', 'closed')]"/>
                <filter name="cancelled" string="Dibatalkan" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="ready" string="Siap gerbang" domain="[('gate_ready', '=', True)]"/>
                <filter name="late" string="Melewati target" domain="[('state', '=', 'active'), ('target_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="stale" string="Tanpa aktivitas 14 hari" domain="[('state', '=', 'active'), ('write_date', '&lt;', (context_today() - relativedelta(days=14)).strftime('%Y-%m-%d'))]"/>
                <filter name="closed_90" string="Di-harvest 90 hari terakhir" domain="[('state', '=', 'closed'), ('closed_date', '&gt;=', (context_today() - relativedelta(days=90)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Kelompokkan">
                    <filter name="group_stage" string="Tahap" context="{'group_by': 'stage_id'}"/>
                    <filter name="group_mode" string="Mode" context="{'group_by': 'mode_id'}"/>
                    <filter name="group_product" string="Produk" context="{'group_by': 'product_id'}"/>
                    <filter name="group_sponsor" string="Sponsor" context="{'group_by': 'sponsor_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_ea_engagement_graph" model="ir.ui.view">
        <field name="name">ea.engagement.graph</field>
        <field name="model">ea.engagement</field>
        <field name="arch" type="xml">
            <graph type="bar" string="Kapasitas EA">
                <field name="mode_id"/>
                <field name="mode_load" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_ea_engagement_pivot" model="ir.ui.view">
        <field name="name">ea.engagement.pivot</field>
        <field name="model">ea.engagement</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="mode_id" type="row"/>
                <field name="stage_id" type="col"/>
                <field name="mode_load" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_ea_desk_board" model="ir.actions.act_window">
        <field name="name">Meja Kerja</field>
        <field name="res_model">ea.engagement</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_running': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Buka engagement pertama</p>
            <p>Setiap permintaan layanan EA, dari /seed sampai /harvest. Mulai dari keputusan yang harus diambil Sponsor.</p>
        </field>
    </record>
    <record id="action_ea_attention" model="ir.actions.act_window">
        <field name="name">Perlu perhatian</field>
        <field name="res_model">ea.engagement</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('state', '=', 'active'), '|', '|', ('gate_ready', '=', True), ('target_date', '&lt;', context_today().strftime('%Y-%m-%d')), ('write_date', '&lt;', (context_today() - relativedelta(days=14)).strftime('%Y-%m-%d'))]</field>
        <field name="help" type="html"><p>Tidak ada yang menunggu. Semua engagement berjalan sesuai gerbangnya.</p></field>
    </record>
    <record id="action_ea_engagement" model="ir.actions.act_window">
        <field name="name">Engagement</field>
        <field name="res_model">ea.engagement</field>
        <field name="view_mode">list,kanban,form,pivot</field>
    </record>
    <record id="action_ea_capacity" model="ir.actions.act_window">
        <field name="name">Kapasitas EA per mode</field>
        <field name="res_model">ea.engagement</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="domain">[('state', '=', 'active')]</field>
        <field name="help" type="html"><p>Bobot: Co-Pilot 3, Advisor 2, Gatekeeper 1, Curator 1 (diatur di Konfigurasi → Mode).</p></field>
    </record>

    <record id="view_ea_gate_pass_graph" model="ir.ui.view">
        <field name="name">ea.gate.pass.graph</field>
        <field name="model">ea.gate.pass</field>
        <field name="arch" type="xml">
            <graph type="bar" string="Gerbang dilewati">
                <field name="passed_date" interval="month"/>
                <field name="stage_id"/>
            </graph>
        </field>
    </record>
    <record id="view_ea_gate_pass_list" model="ir.ui.view">
        <field name="name">ea.gate.pass.list</field>
        <field name="model">ea.gate.pass</field>
        <field name="arch" type="xml">
            <list><field name="engagement_id"/><field name="stage_id"/><field name="approved_by"/><field name="passed_date"/><field name="note"/></list>
        </field>
    </record>
    <record id="action_ea_gate_impact" model="ir.actions.act_window">
        <field name="name">Gerbang dilewati</field>
        <field name="res_model">ea.gate.pass</field>
        <field name="view_mode">graph,list</field>
    </record>
</odoo>
