<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ea_desk" model="ir.module.category">
        <field name="name">EA Desk</field>
        <field name="sequence">50</field>
    </record>
    <record id="group_ea_user" model="res.groups">
        <field name="name">Pengguna</field>
        <field name="category_id" ref="module_category_ea_desk"/>
        <field name="comment">Mengelola engagement, ADR, artefak, dan backlog /foundation.</field>
    </record>
    <record id="group_ea_manager" model="res.groups">
        <field name="name">Enterprise Architect (pengelola)</field>
        <field name="category_id" ref="module_category_ea_desk"/>
        <field name="implied_ids" eval="[(4, ref('group_ea_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Juga merancang Produk EA dan mengubah konfigurasi tata kelola (tahap, mode, kriteria).</field>
    </record>
</odoo>
