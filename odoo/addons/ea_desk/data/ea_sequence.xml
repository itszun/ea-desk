<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_ea_engagement" model="ir.sequence">
        <field name="name">Engagement EA</field>
        <field name="code">ea.engagement</field>
        <field name="prefix">ENG-%(year)s-</field>
        <field name="padding">3</field>
    </record>
    <record id="seq_ea_decision" model="ir.sequence">
        <field name="name">ADR</field>
        <field name="code">ea.decision</field>
        <field name="prefix">ADR-</field>
        <field name="padding">3</field>
    </record>
    <record id="seq_ea_issue" model="ir.sequence">
        <field name="name">Isu &amp; Asumsi</field>
        <field name="code">ea.issue</field>
        <field name="prefix">ISU-</field>
        <field name="padding">3</field>
    </record>
</odoo>
